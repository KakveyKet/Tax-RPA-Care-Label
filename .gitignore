# ==========================================
# RPA Care Label - Git Ignore
# ==========================================

# 1. Database & Security (CRITICAL)
# Ignore the SQLite database so user accounts and hashes aren't exposed
*.db
*.sqlite3
pdf_history.db

# 2. Uploaded / Extracted Files
# Ignore any PDFs that accidentally get saved to the main project folder
*.pdf
*.zip
extracted_*/

# 3. Python Virtual Environments
# Ignore the local environment files (other devs should build their own)
venv/
.venv/
env/
.env/

# 4. Standard Python Cache Files
# Ignore compiled Python bytecode
__pycache__/
*.py[cod]
*$py.class

# 5. OS Generated Files
# Ignore hidden system files generated by Windows or Mac
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 6. IDE / Editor Folders
# Ignore settings from code editors like VS Code or PyCharm
.vscode/
.idea/
*.swp
*.swo